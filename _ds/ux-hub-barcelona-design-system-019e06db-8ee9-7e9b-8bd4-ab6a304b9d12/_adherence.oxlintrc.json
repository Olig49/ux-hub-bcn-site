      "--uxh-h2-lh",
      "--uxh-h2-size",
      "--uxh-h2-tracking",
      "--uxh-h3-lh",
      "--uxh-h3-size",
      "--uxh-h3-tracking",
      "--uxh-lime",
      "--uxh-line",
